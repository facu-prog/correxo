# Variables de entorno (se cargan en Railway → servicio correxo → Variables).
# NO subir valores reales a git.

# --- Stripe (cobro del reporte, flujo público self-serve) ---
STRIPE_SECRET_KEY=sk_test_xxx        # clave secreta (TEST para probar, LIVE en prod)
STRIPE_PRICE_ID=price_xxx            # Price creado en Stripe (define monto y moneda)

# --- Backend del piloto ---
DATABASE_URL=                        # en Railway = referencia ${{Postgres.DATABASE_URL}} (no setear a mano)
VIDEO_DIR=/data/videos               # carpeta de videos dentro del volumen montado en /data
OPERATOR_PIN=251919                  # PIN para el modo operador (cambiar antes del piloto)
# PGSSL=require                      # solo si se conecta a un Postgres externo que exige SSL
